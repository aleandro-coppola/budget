# Copia questo file in ".env.local" e riempi i valori.
# NON committare mai .env.local (e' gia' in .gitignore).

# Token dell'integrazione Notion (NON quello incollato in chat: rigeneralo!)
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Password fissa per accedere all'app
APP_PASSWORD=cambia-questa-password

# Sale opzionale per il token di sessione (una stringa a caso qualsiasi)
SESSION_SALT=una-stringa-lunga-a-caso

# Stipendi (opzionali: se assenti usa i default nel codice, Ale 2359 / Cris 1500)
# SALARY_ALE=2359
# SALARY_CRIS=1500
